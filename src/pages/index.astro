---
import '../styles/tokens.css';
import '../styles/app.css';
import Reader from '../reader/Reader.tsx';
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Jesus Tracker</title>
    <meta name="description" content="The four gospels side by side, aligned event by event, with a timeline and a map." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23E9DFC6'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23A85F0C'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&family=Courier+Prime:wght@400;700&family=Figtree:wght@400..700&display=swap"
    />
  </head>
  <body data-light="unstated">
    <Reader client:only="react">
      <p slot="fallback" class="boot">Loading the four gospels…</p>
    </Reader>
    <noscript><p class="boot">This reader needs JavaScript to align the four accounts.</p></noscript>
  </body>
</html>

<style is:global>
  .boot {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-scripture);
    color: var(--ink-soft);
  }
</style>
